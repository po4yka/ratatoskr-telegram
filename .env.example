# Every configuration variable of this service, with the default each one falls back to.
#
# The built-in defaults are written once, in `crates/core/src/config`, and this file documents them.
# Nothing here needs to be set for a local run: both binaries start on loopback admin listeners,
# log JSON to stdout, and export nothing. A deployment sets what it needs from this table.
#
# Secrets are marked SECRET: they are `SecretString`s that render as `[REDACTED]` in every log line
# and in `<binary> check-config` output, and they are never echoed by a startup-failure report.

# The operator listener: /health/live, /health/ready, /metrics, /version.
# Default per role — webhook: 127.0.0.1:9467, dispatcher: 127.0.0.1:9468.
#RATATOSKR__ADMIN__BIND=127.0.0.1:9467

# The Bot API origin this service calls. Default https://api.telegram.org.
# Must be https unless the host is a loopback address (rule V9), which is what a local harness
# server for offline runs is.
#RATATOSKR__BOT_API__BASE_URL=https://api.telegram.org

# Whole-call budget for one Bot API request, 1..=60 seconds. Default 10.
#RATATOSKR__BOT_API__TIMEOUT_SECONDS=10

# The bot credential, learned from BotFather. Required by the webhook role (rule V13); the
# dispatcher does not send yet.
# SECRET: renders as [REDACTED] everywhere; travels only inside request paths to the Bot API.
#RATATOSKR__BOT_API__TOKEN=123456:ABC-DEF_your-bot-token

# The public update-intake listener. Default 127.0.0.1:9469; must differ from the admin bind.
# A deployment sets its ingress-facing address explicitly.
#RATATOSKR__WEBHOOK__BIND=127.0.0.1:9469

# The webhook secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token on every delivery.
# Required by the webhook role (rule V13): 16..=256 characters over [A-Za-z0-9_-].
# Generate with: openssl rand -base64 48 | tr '+/' '-_'
# SECRET: compared in constant time against every delivery before any body byte is read.
#RATATOSKR__WEBHOOK__SECRET_TOKEN=

# Maximum accepted request body, 1024..=1048576 bytes. Default 262144 (256 KiB). Real updates are
# small; the cap exists so a forged delivery cannot buy memory.
#RATATOSKR__WEBHOOK__MAX_BODY_BYTES=262144

# The PostgreSQL connection this service owns (the `telegram` schema). Required by the webhook
# role (rule V13) — intake writes update deduplication through it and refuses to start when it
# cannot be reached. The dispatcher may still run without one.
# SECRET: carries the password in its user information.
#RATATOSKR__DATABASE__URL=postgres://telegram:telegram@127.0.0.1:5432/telegram

# Pool ceiling, 1..=100. Default 10.
#RATATOSKR__DATABASE__MAX_CONNECTIONS=10

# Seconds to wait for a pooled connection, 1..=30. Default 5.
#RATATOSKR__DATABASE__ACQUIRE_TIMEOUT_SECONDS=5

# Seconds to keep serving after SIGTERM while readiness already reports 503, 0..=60. Default 5.
#RATATOSKR__SHUTDOWN__DRAIN_SECONDS=5

# Seconds allowed for in-flight work after the listener stops accepting, 1..=120. Default 25.
#RATATOSKR__SHUTDOWN__GRACE_SECONDS=25

# Log rendering: json (default) or pretty.
#RATATOSKR__TELEMETRY__LOG_FORMAT=json

# A tracing-subscriber EnvFilter directive string. Default below.
#RATATOSKR__TELEMETRY__LOG_FILTER=info,tower_http=info,hyper=warn,h2=warn

# OTLP span export. Absent: spans still mint real trace ids; nothing is exported.
# Must be https unless the host is a loopback address.
#RATATOSKR__TELEMETRY__OTLP__ENDPOINT=https://collector.example:4317

# Export timeout in seconds, 1..=60. Default 5.
#RATATOSKR__TELEMETRY__OTLP__TIMEOUT_SECONDS=5

# Collector authentication headers. Each value is a SECRET.
#RATATOSKR__TELEMETRY__OTLP__HEADERS__AUTHORIZATION=
